      ],
      "typeVersion": 3.2
    },
    {
      "parameters": {
        "content": "## Replace Me\nIf you want, replace me with the provider and model you prefer!\n\nMaybe pick one out on our [AI Benchmark](https://n8n.io/ai-benchmark)",
        "height": 320,
        "width": 224
      },
